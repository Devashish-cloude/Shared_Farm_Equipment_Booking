# ==============================================================================
# SHARED FARM — FRONTEND ENVIRONMENT TEMPLATE
# Copy to frontend/.env for local Vite development.
# ==============================================================================

VITE_API_BASE_URL=http://localhost:5001/api
VITE_API_URL=http://localhost:5001/api
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
VITE_MAP_TILE_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TELEMETRY_REFRESH_INTERVAL_MS=6000

# Supabase Client Configuration
# Obtain your project URL and publishable anon key from Supabase Dashboard -> Project Settings -> API
# NEVER expose a Supabase service-role key or secret key in browser code!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
# Supabase Publishable Key (New format supported interchangeably):
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Google Maps API Key
# Enables Google Maps JavaScript API, Places Autocomplete, and Satellite layers.
# Restrict in Google Cloud Console by HTTP referrer (e.g., https://your-domain.vercel.app/* and http://localhost:5173/*)
# and enable Maps JavaScript API and Places API.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

