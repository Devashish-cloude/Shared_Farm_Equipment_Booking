# Shared Farm — Frontend Environment Configuration

# Backend API Base URL (Separate backend developed by Person 2)
# When unset or in Demo Mode, application transparently uses local mock store
VITE_API_BASE_URL=http://localhost:5000/api

# OpenStreetMap Tile Layer URL
VITE_MAP_TILE_PROVIDER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Live Tractor Telemetry Polling Interval (in milliseconds)
VITE_TELEMETRY_REFRESH_INTERVAL_MS=6000
