# ==============================================================================
# SHARED FARM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development. Never commit real secret keys.
# ==============================================================================

# Server configuration
PORT=5001
NODE_ENV=development
API_BASE_URL=http://localhost:5001/api

# Client configuration (Vite exposes variables prefixed with VITE_)
VITE_API_URL=http://localhost:5001/api
VITE_API_BASE_URL=http://localhost:5001/api
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# JWT Authentication secret
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL configuration (used by explicit database commands during Phase 1)
DATABASE_URL=postgresql://postgres:password@localhost:5432/shared_farm
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false
# Certificate verification remains enabled by default; production always verifies.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_MIGRATION_LOCK_KEY=shared-farm-schema-migrations
# Configuring DATABASE_URL does not migrate existing application routes yet.

# Razorpay Test Gateway Configuration (Server only)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder
# Optional local-only test bypass; always disabled when NODE_ENV=production.
PAYMENT_ALLOW_DEMO_SIMULATION=false
# Optional local-only demo authentication header; always disabled in production.
DEMO_AUTH_ALLOW_HEADER=false

# Equipment Tracking Configuration
TRACKING_STALE_THRESHOLD_MINUTES=5
SIMULATED_GPS_DEFAULT_INTERVAL_SEC=3
